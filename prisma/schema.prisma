generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ENUMS

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

// MODELS
model User {
  id String @id @default(uuid())

  email        String @unique
  publicSlug   String @unique
  passwordHash String

  firstName String
  lastName  String

  phone     String?
  avatarUrl String?

  timezone String? @default("UTC")
  locale   String? @default("en-US")

  emailVerified Boolean @default(false)
  isActive      Boolean @default(true)

  lastLoginAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  memberships        OrganizationUser[]
  ownedOrganizations Organization[]     @relation("OrganizationOwner")

  sessions            Session[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  loginOtps           LoginOtp[]

  auditLogs     AuditLog[]
  loginAttempts LoginAttempt[]

  @@index([deletedAt])
  @@index([isActive])
  @@index([lastLoginAt])
  @@map("users")
}

model Organization {
  id String @id @default(uuid())

  name String
  slug String @unique

  logoUrl  String?
  website  String?
  timezone String?

  status OrganizationStatus @default(ACTIVE)

  ownerId String
  owner   User   @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  members     OrganizationUser[]
  roles       Role[]
  invitations Invitation[]
  auditLogs   AuditLog[]
  sessions    Session[]

  loginAttempts LoginAttempt[]

  @@index([ownerId])
  @@index([status])
  @@index([deletedAt])
  @@index([status, deletedAt])
  @@index([status, createdAt])
  @@map("organizations")
}

model OrganizationUser {
  id String @id @default(uuid())

  organizationId String
  userId         String

  // Denormalized for fast org-scoped email lookups
  email String

  status UserStatus @default(ACTIVE)

  joinedAt  DateTime?
  invitedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  invitedByMember OrganizationUser?  @relation("MemberInvitedBy", fields: [invitedBy], references: [id], onDelete: SetNull)
  invitedMembers  OrganizationUser[] @relation("MemberInvitedBy")

  roles MemberRole[]

  @@unique([organizationId, userId])
  @@unique([organizationId, email])
  @@index([organizationId, status])
  @@index([userId, status])
  @@index([organizationId, createdAt])
  @@index([invitedBy])
  @@map("organization_users")
}

model Role {
  id String @id @default(uuid())

  organizationId String

  name        String
  publicSlug  String @unique
  key         String?
  description String?

  isSystem Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  permissions RolePermission[]
  members     MemberRole[]

  @@unique([organizationId, name])
  @@unique([organizationId, key])
  @@index([organizationId, isSystem])
  @@map("roles")
}

model Permission {
  id String @id @default(uuid())

  module String
  action String
  key    String @unique

  description String?
  isActive    Boolean @default(true)

  roles RolePermission[]

  @@index([module])
  @@index([isActive])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model MemberRole {
  memberId String
  roleId   String

  member OrganizationUser @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role   Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([memberId, roleId])
  @@index([roleId])
  @@map("member_roles")
}

model Session {
  id String @id @default(uuid())

  userId         String
  organizationId String

  device  String?
  browser String?
  os      String?

  ipAddress String?
  userAgent String?

  status SessionStatus @default(ACTIVE)

  expiresAt  DateTime
  lastUsedAt DateTime?

  createdAt DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  refreshTokens RefreshToken[]

  @@index([userId, organizationId, status])
  @@index([organizationId, status, expiresAt])
  @@index([expiresAt])
  @@map("sessions")
}

model RefreshToken {
  id String @id @default(uuid())

  userId    String
  sessionId String

  tokenHash String @unique

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@index([expiresAt, revokedAt])
  @@map("refresh_tokens")
}

model Invitation {
  id String @id @default(uuid())

  organizationId String

  email String

  tokenHash String @unique

  invitedById String?

  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, email])
  @@index([organizationId, acceptedAt])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("organization_invitations")
}

model LoginAttempt {
  id String @id @default(uuid())

  userId         String?
  organizationId String?

  email     String
  ipAddress String
  success   Boolean

  createdAt DateTime @default(now())

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
  @@index([organizationId, createdAt])
  @@map("login_attempts")
}

model AuditLog {
  id String @id @default(uuid())

  organizationId String?
  userId         String?

  action   String
  entity   String
  entityId String?

  oldValue Json?
  newValue Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, userId, action, createdAt])
  @@index([organizationId, createdAt, action])
  @@index([entity, entityId, organizationId])
  @@map("audit_logs")
}

model PasswordResetToken {
  id String @id @default(uuid())

  userId String

  tokenHash String? @unique
  otpHash   String? @unique

  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
  @@map("password_reset_tokens")
}

model LoginOtp {
  id String @id @default(uuid())

  userId String

  otpHash String @unique

  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
  @@map("login_otps")
}
